---
type PocketBaseRecord = {
	id: string;
	name: string;
	menuImage: string | string[];
	sort?: number;
};

type SiteSettingsRecord = {
	id: string;
	footerLogo?: string;
	hours?: string;
	facebookUrl?: string;
	instagramUrl?: string;
};

type AddressRecord = {
	address?: string;
	description?: string;
	phoneNumber?: string;
	sort?: number;
};

type Address = {
	address: string;
	description: string;
	phoneNumber: string;
};

type SiteSettings = {
	footerLogoUrl: string;
	addresses: Address[];
	hours: string;
	facebookUrl: string;
	instagramUrl: string;
};

type Category = {
	name: string;
	slug: string;
	imageUrls: string[];
	tone: number;
	shapeStyle: string;
};

const pocketBaseUrl = import.meta.env.PUBLIC_POCKETBASE_URL?.replace(/\/$/, '') ?? '';
const restaurantName = 'ياقوت';
let categories: Category[] = [];
let cmsError = '';

const fallbackSettings = {
	footerLogoUrl: '',
	addresses: [
		{
			address: 'Cairo, Egypt',
			description: '',
			phoneNumber: '0100 000 0000',
		},
	],
	hours: 'Daily 10:00 AM - 12:00 AM',
	facebookUrl: '#',
	instagramUrl: '#',
};

let restaurant: SiteSettings = fallbackSettings;

function toneFromSlug(slug: string) {
	const total = [...slug].reduce((sum, char) => sum + char.charCodeAt(0), 0);
	return (total % 12) + 1;
}

function slugFromName(name: string) {
	return name.trim().toLowerCase().replace(/\s+/g, '-');
}

function randomShapeStyle(slug: string, index: number) {
	const seed = [...`${slug}-${index}`].reduce(
		(sum, char, charIndex) => sum + char.charCodeAt(0) * (charIndex + 17),
		0
	);
	const pick = (values: string[], offset: number) =>
		values[(seed * (offset + 3) + index * (offset + 11)) % values.length];
	const range = (min: number, max: number, offset: number) => {
		const ratio = ((seed * (offset + 5) + index * (offset + 29)) % 100) / 100;
		return min + (max - min) * ratio;
	};

	return [
		`--shape-one-size:${range(7.2, 11.2, 1).toFixed(2)}rem`,
		`--shape-one-top:${range(-3.2, 2.2, 2).toFixed(2)}rem`,
		`--shape-one-end:${range(-4.4, 1.4, 3).toFixed(2)}rem`,
		`--shape-one-radius:${pick(['50%', '34% 66% 45% 55%', '8px', '999px', '62% 38% 70% 30%'], 4)}`,
		`--shape-two-width:${range(6.2, 11.4, 5).toFixed(2)}rem`,
		`--shape-two-height:${range(2, 6, 6).toFixed(2)}rem`,
		`--shape-two-bottom:${range(1.2, 5.8, 7).toFixed(2)}rem`,
		`--shape-two-top:${pick(['auto', '14%', '28%', '42%', '58%', '70%'], 8)}`,
		`--shape-two-end:${range(-4.2, 1.8, 9).toFixed(2)}rem`,
		`--shape-two-radius:${pick(['50%', '8px', '999px', '42% 58% 36% 64%', '18% 82% 24% 76%'], 10)}`,
		`--shape-two-rotate:${Math.round(range(-34, 38, 11))}deg`,
		`--shape-three-size:${range(0.85, 1.9, 12).toFixed(2)}rem`,
		`--shape-three-top:${Math.round(range(16, 74, 13))}%`,
		`--shape-three-end:${Math.round(range(8, 28, 14))}%`,
		`--shape-three-rotate:${Math.round(range(0, 90, 15))}deg`,
		`--shape-three-path:${pick(
			[
				'polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%)',
				'polygon(50% 0, 100% 100%, 0 100%)',
				'polygon(25% 0, 100% 0, 75% 100%, 0 100%)',
				'circle(50% at 50% 50%)',
				'polygon(50% 0, 100% 38%, 82% 100%, 18% 100%, 0 38%)',
			],
			16
		)}`,
	].join(';');
}

function normalizeAddresses(addresses: AddressRecord[]): Address[] {
	const validAddresses = addresses
		.filter((item): item is Record<string, unknown> => item !== null && typeof item === 'object')
		.map((item) => ({
			address: typeof item.address === 'string' ? item.address.trim() : '',
			description: typeof item.description === 'string' ? item.description.trim() : '',
			phoneNumber: typeof item.phoneNumber === 'string' ? item.phoneNumber.trim() : '',
		}))
		.filter((item) => item.address && item.phoneNumber);

	return validAddresses.length > 0 ? validAddresses : fallbackSettings.addresses;
}

function normalizeMenuImages(menuImage: PocketBaseRecord['menuImage']): string[] {
	return (Array.isArray(menuImage) ? menuImage : [menuImage])
		.map((fileName) => fileName.trim())
		.filter(Boolean);
}

if (pocketBaseUrl) {
	try {
		const params = new URLSearchParams({
			perPage: '1',
		});
		const response = await fetch(
			`${pocketBaseUrl}/api/collections/site_settings/records?${params.toString()}`
		);

		if (!response.ok) {
			throw new Error(`PocketBase returned ${response.status}`);
		}

		const data = (await response.json()) as { items?: SiteSettingsRecord[] };
		const settings = data.items?.[0];
		const footerLogoUrl =
			settings?.id && settings.footerLogo
				? `${pocketBaseUrl}/api/files/site_settings/${settings.id}/${encodeURIComponent(
						settings.footerLogo
					)}`
				: fallbackSettings.footerLogoUrl;
		restaurant = {
			...fallbackSettings,
			...settings,
			footerLogoUrl,
		};
	} catch {
		restaurant = fallbackSettings;
	}

	try {
		const params = new URLSearchParams({
			sort: 'sort,address',
			filter: 'isActive=true',
		});
		const response = await fetch(
			`${pocketBaseUrl}/api/collections/footer_addresses/records?${params.toString()}`
		);

		if (!response.ok) {
			throw new Error(`PocketBase returned ${response.status}`);
		}

		const data = (await response.json()) as { items?: AddressRecord[] };
		restaurant = {
			...restaurant,
			addresses: normalizeAddresses(data.items ?? []),
		};
	} catch {
		restaurant = {
			...restaurant,
			addresses: fallbackSettings.addresses,
		};
	}

	try {
		const params = new URLSearchParams({
			sort: 'sort,name',
			filter: 'isActive=true',
		});
		const response = await fetch(
			`${pocketBaseUrl}/api/collections/categories/records?${params.toString()}`
		);

		if (!response.ok) {
			throw new Error(`PocketBase returned ${response.status}`);
		}

		const data = (await response.json()) as { items?: PocketBaseRecord[] };
		categories =
			data.items
				?.filter((record) => record.name && record.menuImage)
				.map((record, index) => {
					const slug = slugFromName(record.name);
					const imageUrls = normalizeMenuImages(record.menuImage).map(
						(fileName) =>
							`${pocketBaseUrl}/api/files/categories/${record.id}/${encodeURIComponent(fileName)}`
					);

					return {
						name: record.name,
						slug,
						imageUrls,
						tone: toneFromSlug(slug),
						shapeStyle: randomShapeStyle(slug, index),
					};
				})
				.filter((category) => category.imageUrls.length > 0) ?? [];
	} catch (error) {
		cmsError = error instanceof Error ? error.message : 'Could not load menu.';
	}
}
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Yakoot restaurant menu categories and menu images."
		/>
		<title>{restaurantName} Menu</title>
	</head>
	<body>
		<header class="site-header" aria-label="Primary">
			<a class="brand" href="/" aria-label={`${restaurantName} home`}>
				{restaurantName}
			</a>
			<nav class="social-links" aria-label="Social links">
				<a class="icon-link" href={restaurant.facebookUrl} aria-label="Facebook">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
					</svg>
				</a>
				<a class="icon-link" href={restaurant.instagramUrl} aria-label="Instagram">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
						<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
						<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
					</svg>
				</a>
			</nav>
		</header>

		<main class="shell">
			{
				categories.length > 0 ? (
					<section class="category-grid" aria-label="Menu categories">
						{categories.map((category) => (
							<button
								class={`category-card tone-${category.tone}`}
								type="button"
								data-slug={category.slug}
								aria-label={`Open ${category.name} menu`}
								style={category.shapeStyle}
							>
								<span class="shape shape-one" aria-hidden="true" />
								<span class="shape shape-two" aria-hidden="true" />
								<span class="shape shape-three" aria-hidden="true" />
								<span class="category-name">{category.name}</span>
							</button>
						))}
					</section>
				) : (
					<section class="empty-state" aria-live="polite">
						<h2>Menu not available</h2>
						<p>
							{pocketBaseUrl
								? cmsError || 'No active categories found.'
								: 'Set PUBLIC_POCKETBASE_URL to load categories.'}
						</p>
					</section>
				)
			}
		</main>

		<footer class="site-footer" aria-label="Restaurant details">
			<div class="footer-shell">
				<section class="footer-panel" aria-label={`${restaurantName} summary`}>
					<div class="footer-brand">
						{
							restaurant.footerLogoUrl ? (
								<img
									class="footer-logo"
									src={restaurant.footerLogoUrl}
									alt={restaurantName}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<strong class="footer-mark">{restaurantName}</strong>
							)
						}
						{restaurant.footerLogoUrl && <strong class="footer-title">{restaurantName}</strong>}
					</div>
					<div class="footer-actions">
						<span class="footer-hours">{restaurant.hours}</span>
					</div>
				</section>
				<section class="footer-contacts" aria-label="Locations">
					<div class="contact-list">
						{
							restaurant.addresses.map((item) => (
								<address class="contact-location">
									<span class="contact-label">الفرع</span>
									<span class="contact-address">{item.address}</span>
									{item.description && <small>{item.description}</small>}
									<a class="contact-phone" href={`tel:${item.phoneNumber.replaceAll(' ', '')}`}>
										{item.phoneNumber}
									</a>
								</address>
							))
						}
					</div>
				</section>
			</div>
		</footer>

		<dialog id="menuDialog" class="menu-dialog" aria-label="Menu image viewer">
			<button class="close" type="button" aria-label="Close menu">×</button>
			<div class="image-stage">
				<div id="menuImages" class="menu-images" aria-live="polite"></div>
			</div>
			<div id="menuDots" class="menu-dots" aria-label="Menu pages"></div>
		</dialog>

		<script type="application/json" id="categories-data" set:html={JSON.stringify(categories)} />

		<script>
			const dataElement = document.getElementById('categories-data');
			const categories = JSON.parse(dataElement?.textContent || '[]');
			const categoriesBySlug = new Map(categories.map((category) => [category.slug, category]));
			const dialog = document.getElementById('menuDialog');
			const menuImages = document.getElementById('menuImages');
			const imageStage = dialog?.querySelector('.image-stage');
			const menuDots = document.getElementById('menuDots');
			const closeButton = dialog?.querySelector('.close');
			let skipCloseUrlSync = false;
			let activeRenderRequest = 0;
			let dotUpdateFrame = 0;

			function setCategoryParam(slug) {
				const url = new URL(window.location.href);
				if (slug) {
					url.searchParams.set('category', slug);
				} else {
					url.searchParams.delete('category');
				}
				window.history.pushState({}, '', url);
			}

			function setActiveDot(index) {
				if (!menuDots) return;

				Array.from(menuDots.children).forEach((dot, dotIndex) => {
					if (!(dot instanceof HTMLButtonElement)) return;
					const isActive = dotIndex === index;
					dot.classList.toggle('is-active', isActive);
					dot.setAttribute('aria-current', isActive ? 'true' : 'false');
				});
			}

			function updateActiveDot() {
				dotUpdateFrame = 0;
				if (!menuImages || !menuDots || menuDots.children.length < 2) return;

				const images = Array.from(menuImages.querySelectorAll('img'));
				const stageRect = (imageStage || menuImages).getBoundingClientRect();
				const stageCenterX = stageRect.left + stageRect.width / 2;
				const stageCenterY = stageRect.top + stageRect.height / 2;
				let activeIndex = 0;
				let activeDistance = Number.POSITIVE_INFINITY;

				images.forEach((image, index) => {
					const imageRect = image.getBoundingClientRect();
					const imageCenterX = imageRect.left + imageRect.width / 2;
					const imageCenterY = imageRect.top + imageRect.height / 2;
					const distance =
						Math.abs(stageCenterX - imageCenterX) + Math.abs(stageCenterY - imageCenterY);

					if (distance < activeDistance) {
						activeDistance = distance;
						activeIndex = index;
					}
				});

				setActiveDot(activeIndex);
			}

			function scheduleDotUpdate() {
				if (dotUpdateFrame) return;
				dotUpdateFrame = window.requestAnimationFrame(updateActiveDot);
			}

			function openCategory(category, shouldPushState = true) {
				if (!dialog || !menuImages || !menuDots || !category) return;

				const requestId = ++activeRenderRequest;
				dialog.dataset.imageState = 'loading';
				menuImages.replaceChildren();
				menuDots.replaceChildren();
				menuImages.classList.toggle('has-multiple-images', category.imageUrls.length > 1);
				menuDots.hidden = category.imageUrls.length < 2;

				if (!dialog.open) {
					dialog.showModal();
				}

				const images = category.imageUrls.map((imageUrl, index) => {
					const image = document.createElement('img');
					image.alt =
						category.imageUrls.length > 1
							? `${category.name} menu page ${index + 1}`
							: `${category.name} menu`;
					image.loading = index === 0 ? 'eager' : 'lazy';
					image.decoding = 'async';
					image.addEventListener(
						'load',
						() => {
							if (requestId === activeRenderRequest) {
								image.dataset.loaded = 'true';
							}
						},
						{ once: true }
					);
					image.src = imageUrl;
					menuImages.append(image);
					if (image.complete) {
						image.dataset.loaded = 'true';
					}
					return image;
				});

				if (category.imageUrls.length > 1) {
					images.forEach((image, index) => {
						const dot = document.createElement('button');
						dot.type = 'button';
						dot.className = 'menu-dot';
						dot.setAttribute('aria-label', `${category.name} menu page ${index + 1}`);
						dot.addEventListener('click', () => {
							image.scrollIntoView({
								behavior: 'smooth',
								block: 'nearest',
								inline: 'center'
							});
							setActiveDot(index);
						});
						menuDots.append(dot);
					});
					setActiveDot(0);
					window.requestAnimationFrame(updateActiveDot);
				}
				dialog.dataset.imageState = 'loaded';

				if (shouldPushState) {
					setCategoryParam(category.slug);
				}
			}

			function closeCategory(shouldPushState = true) {
				if (!dialog || !menuImages || !menuDots) return;
				activeRenderRequest++;
				dialog.dataset.imageState = 'loading';
				menuImages.replaceChildren();
				menuDots.replaceChildren();
				menuDots.hidden = true;
				menuImages.classList.remove('has-multiple-images');
				if (dialog.open) {
					skipCloseUrlSync = true;
					dialog.close();
				}
				if (shouldPushState) {
					setCategoryParam('');
				}
			}

			document.querySelectorAll('.category-card').forEach((button) => {
				button.addEventListener('click', () => {
					const category = categoriesBySlug.get(button.dataset.slug);
					openCategory(category);
				});
			});

			closeButton?.addEventListener('click', () => closeCategory());
			menuImages?.addEventListener('scroll', scheduleDotUpdate, { passive: true });
			imageStage?.addEventListener('scroll', scheduleDotUpdate, { passive: true });
			window.addEventListener('resize', scheduleDotUpdate);
			dialog?.addEventListener('click', (event) => {
				if (
					!menuImages ||
					closeButton?.contains(event.target) ||
					menuDots?.contains(event.target)
				)
					return;
				if (!menuImages.contains(event.target)) {
					closeCategory();
				}
			});
			dialog?.addEventListener('close', () => {
				if (skipCloseUrlSync) {
					skipCloseUrlSync = false;
					return;
				}

				const activeSlug = new URL(window.location.href).searchParams.get('category');
				if (activeSlug) {
					setCategoryParam('');
				}
			});

			window.addEventListener('popstate', () => {
				const slug = new URL(window.location.href).searchParams.get('category');
				const category = slug ? categoriesBySlug.get(slug) : null;
				if (category) {
					openCategory(category, false);
				} else {
					closeCategory(false);
				}
			});

			const initialSlug = new URL(window.location.href).searchParams.get('category');
			if (initialSlug && categoriesBySlug.has(initialSlug)) {
				openCategory(categoriesBySlug.get(initialSlug), false);
			}
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--ink: #251817;
		--muted: #6f5b56;
		--paper: #fff8ef;
		--cream: #f3e2ca;
		--rose: #9f6f70;
		--plum: #513341;
		--gold: #c58a2d;
		--green: #406450;
		--shadow: 0 24px 60px rgb(62 33 28 / 16%);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		min-height: 100%;
		background:
			radial-gradient(circle at 18% 18%, rgb(197 138 45 / 18%), transparent 28rem),
			radial-gradient(circle at 92% 10%, rgb(64 100 80 / 14%), transparent 24rem),
			linear-gradient(135deg, var(--paper), #f6ead9 54%, #efe0d4);
		color: var(--ink);
	}

	body {
		min-height: 100vh;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	button,
	a {
		-webkit-tap-highlight-color: transparent;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem clamp(1rem, 4vw, 3.5rem);
		background: rgb(255 248 239 / 82%);
		backdrop-filter: blur(18px);
		border-bottom: 1px solid rgb(37 24 23 / 10%);
	}

	.brand,
	.icon-link {
		color: var(--ink);
		text-decoration: none;
	}

	.brand {
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2rem, 6vw, 3.8rem);
		font-weight: 700;
		line-height: 0.9;
	}

	.social-links {
		direction: ltr;
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}

	.icon-link {
		width: 2.45rem;
		height: 2.45rem;
		border: 1px solid rgb(37 24 23 / 14%);
		border-radius: 999px;
		display: grid;
		place-items: center;
		background: rgb(255 255 255 / 42%);
		transition:
			background 180ms ease,
			transform 180ms ease,
			border-color 180ms ease;
	}

	.icon-link:hover,
	.icon-link:focus-visible {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--paper);
		transform: translateY(-1px);
	}

	.icon-link svg {
		width: 1.18rem;
		height: 1.18rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.shell {
		width: min(1120px, calc(100% - 2rem));
		margin: 0 auto;
		padding: clamp(1.5rem, 5vw, 3rem) 0 4rem;
		flex: 1;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr));
		gap: clamp(0.9rem, 2.5vw, 1.4rem);
	}

	.category-card {
		position: relative;
		isolation: isolate;
		min-height: clamp(11rem, 27vw, 17rem);
		overflow: hidden;
		border: 1px solid rgb(255 255 255 / 45%);
		border-radius: 8px;
		padding: 1.2rem;
		display: flex;
		align-items: flex-end;
		justify-content: flex-start;
		text-align: start;
		color: #fffaf1;
		background: var(--card-bg, var(--rose));
		box-shadow: var(--shadow);
		cursor: pointer;
		transform: translateY(0);
		transition:
			transform 180ms ease,
			box-shadow 180ms ease,
			filter 180ms ease;
	}

	.category-card::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -2;
		background:
			linear-gradient(270deg, rgb(18 12 10 / 52%), rgb(18 12 10 / 18%) 42%, transparent 72%),
			linear-gradient(135deg, rgb(255 255 255 / 22%), transparent 42%),
			radial-gradient(circle at 75% 8%, rgb(255 255 255 / 18%), transparent 10rem);
	}

	.category-card::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			linear-gradient(90deg, rgb(255 255 255 / 7%) 1px, transparent 1px),
			linear-gradient(rgb(255 255 255 / 6%) 1px, transparent 1px);
		background-size: 32px 32px;
		mask-image: linear-gradient(to top, black, transparent 78%);
	}

	.category-card:hover,
	.category-card:focus-visible {
		transform: translateY(-4px);
		box-shadow: 0 32px 76px rgb(62 33 28 / 22%);
		filter: saturate(1.05);
	}

	.category-card:focus-visible,
	a:focus-visible {
		outline: 3px solid var(--gold);
		outline-offset: 4px;
	}

	.category-name {
		position: relative;
