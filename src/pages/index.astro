---
type PocketBaseRecord = {
	id: string;
	name: string;
	menuImage: string | string[];
	sort?: number;
};

type SiteSettingsRecord = {
	id: string;
	logo?: string;
	footerLogo?: string;
	hours?: string;
	facebookUrl?: string;
	instagramUrl?: string;
	showFooter?: boolean;
};

type AddressRecord = {
	address?: string;
	description?: string;
	phoneNumber?: string;
	sort?: number;
};

type Address = {
	address: string;
	description: string;
	phoneNumber: string;
};

type SiteSettings = {
	logoUrl: string;
	footerLogoUrl: string;
	addresses: Address[];
	hours: string;
	facebookUrl: string;
	instagramUrl: string;
	showFooter: boolean;
};

type Category = {
	name: string;
	slug: string;
	imageUrls: string[];
};

const pocketBaseUrl = import.meta.env.PUBLIC_POCKETBASE_URL?.replace(/\/$/, '') ?? '';
const restaurantName = 'ياقوت';
const currentYear = new Date().getFullYear();
let categories: Category[] = [];
let cmsError = '';

const fallbackSettings = {
	logoUrl: '',
	footerLogoUrl: '',
	addresses: [
		{
			address: 'Cairo, Egypt',
			description: '',
			phoneNumber: '0100 000 0000',
		},
	],
	hours: 'Daily 10:00 AM - 12:00 AM',
	facebookUrl: '#',
	instagramUrl: '#',
	showFooter: true,
};

let restaurant: SiteSettings = fallbackSettings;

function slugFromName(name: string) {
	return name.trim().toLowerCase().replace(/\s+/g, '-');
}

function normalizeAddresses(addresses: AddressRecord[]): Address[] {
	const validAddresses = addresses
		.filter((item): item is Record<string, unknown> => item !== null && typeof item === 'object')
		.map((item) => ({
			address: typeof item.address === 'string' ? item.address.trim() : '',
			description: typeof item.description === 'string' ? item.description.trim() : '',
			phoneNumber: typeof item.phoneNumber === 'string' ? item.phoneNumber.trim() : '',
		}))
		.filter((item) => item.address && item.phoneNumber);

	return validAddresses.length > 0 ? validAddresses : fallbackSettings.addresses;
}

function normalizeMenuImages(menuImage: PocketBaseRecord['menuImage']): string[] {
	return (Array.isArray(menuImage) ? menuImage : [menuImage])
		.map((fileName) => fileName.trim())
		.filter(Boolean);
}

if (pocketBaseUrl) {
	try {
		const params = new URLSearchParams({
			perPage: '1',
		});
		const response = await fetch(
			`${pocketBaseUrl}/api/collections/site_settings/records?${params.toString()}`
		);

		if (!response.ok) {
			throw new Error(`PocketBase returned ${response.status}`);
		}

		const data = (await response.json()) as { items?: SiteSettingsRecord[] };
		const settings = data.items?.[0];
		const logoUrl =
			settings?.id && settings.logo
				? `${pocketBaseUrl}/api/files/site_settings/${settings.id}/${encodeURIComponent(
						settings.logo
					)}`
				: fallbackSettings.logoUrl;
		const footerLogoUrl =
			settings?.id && settings.footerLogo
				? `${pocketBaseUrl}/api/files/site_settings/${settings.id}/${encodeURIComponent(
						settings.footerLogo
					)}`
				: fallbackSettings.footerLogoUrl;
		restaurant = {
			...fallbackSettings,
			...settings,
			logoUrl,
			footerLogoUrl,
		};
	} catch {
		restaurant = fallbackSettings;
	}

	try {
		const params = new URLSearchParams({
			sort: 'sort,address',
			filter: 'isActive=true',
		});
		const response = await fetch(
			`${pocketBaseUrl}/api/collections/footer_addresses/records?${params.toString()}`
		);

		if (!response.ok) {
			throw new Error(`PocketBase returned ${response.status}`);
		}

		const data = (await response.json()) as { items?: AddressRecord[] };
		restaurant = {
			...restaurant,
			addresses: normalizeAddresses(data.items ?? []),
		};
	} catch {
		restaurant = {
			...restaurant,
			addresses: fallbackSettings.addresses,
		};
	}

	try {
		const params = new URLSearchParams({
			sort: 'sort,name',
			filter: 'isActive=true',
		});
		const response = await fetch(
			`${pocketBaseUrl}/api/collections/categories/records?${params.toString()}`
		);

		if (!response.ok) {
			throw new Error(`PocketBase returned ${response.status}`);
		}

		const data = (await response.json()) as { items?: PocketBaseRecord[] };
		categories =
			data.items
				?.filter((record) => record.name && record.menuImage)
				.map((record, index) => {
					const slug = slugFromName(record.name);
					const imageUrls = normalizeMenuImages(record.menuImage).map(
						(fileName) =>
							`${pocketBaseUrl}/api/files/categories/${record.id}/${encodeURIComponent(fileName)}`
					);

					return {
						name: record.name,
						slug,
						imageUrls,
					};
				})
				.filter((category) => category.imageUrls.length > 0) ?? [];
	} catch (error) {
		cmsError = error instanceof Error ? error.message : 'Could not load menu.';
	}
}
---

<!doctype html>
<html lang="ar" dir="rtl">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Yakoot restaurant menu categories and menu images."
		/>
		<title>{restaurantName} Menu</title>
	</head>
	<body>
		<header class="site-header" aria-label="Primary">
			<a class="brand" href="/" aria-label={restaurantName}>
				{restaurant.logoUrl ? (
					<img
						class="header-logo"
						src={restaurant.logoUrl}
						alt={restaurantName}
						decoding="async"
					/>
				) : (
					<strong class="brand-text">{restaurantName}</strong>
				)}
			</a>
			<nav class="social-links" aria-label="Social links">
				<a class="icon-link" href={restaurant.facebookUrl} aria-label="Facebook">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
					</svg>
				</a>
				<a class="icon-link" href={restaurant.instagramUrl} aria-label="Instagram">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
						<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
						<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
					</svg>
				</a>
			</nav>
		</header>

		<main class="shell">
			{
				categories.length > 0 ? (
					<section class="category-grid" aria-label="Menu categories">
						{categories.map((category) => (
							<button
								class="category-card"
								type="button"
								data-slug={category.slug}
								aria-label={`Open ${category.name} menu`}
							>
								<span class="category-name">{category.name}</span>
							</button>
						))}
					</section>
				) : (
					<section class="empty-state" aria-live="polite">
						<h2>Menu not available</h2>
						<p>
							{pocketBaseUrl
								? cmsError || 'No active categories found.'
								: 'Set PUBLIC_POCKETBASE_URL to load categories.'}
						</p>
					</section>
				)
			}
		</main>

		{
			restaurant.showFooter && (
				<footer class="site-footer" aria-label="Restaurant details">
					<div class="footer-shell">
						<section class="footer-brand" aria-label={`${restaurantName} logo`}>
							{restaurant.footerLogoUrl ? (
								<img
									class="footer-logo"
									src={restaurant.footerLogoUrl}
									alt={restaurantName}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<strong class="footer-mark">{restaurantName}</strong>
							)}
						</section>
						<section class="footer-section footer-contacts" aria-label="Locations">
							<h2 class="footer-title">فروعنا</h2>
							<div class="contact-list">
								{restaurant.addresses.map((item) => (
									<address class="contact-location">
										<div class="contact-heading">
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
												<polyline points="9 22 9 12 15 12 15 22" />
											</svg>
											<span class="contact-address">{item.address}</span>
										</div>
										<a class="contact-line contact-phone" href={`tel:${item.phoneNumber.replaceAll(' ', '')}`}>
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.91.33 1.8.62 2.65a2 2 0 0 1-.45 2.11L8 9.75a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.29 1.74.5 2.65.62A2 2 0 0 1 22 16.92Z" />
											</svg>
											<span>{item.phoneNumber}</span>
										</a>
										{item.description && (
											<span class="contact-line">
												<svg viewBox="0 0 24 24" aria-hidden="true">
													<path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" />
													<circle cx="12" cy="10" r="3" />
												</svg>
												<small>{item.description}</small>
											</span>
										)}
									</address>
								))}
							</div>
						</section>
						<section class="footer-section footer-hours-section" aria-label="Working hours">
							<h2 class="footer-title">ساعات العمل</h2>
							<div class="hours-row">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<circle cx="12" cy="12" r="9" />
									<path d="M12 7v5l3 2" />
								</svg>
								<div>
									<strong>جميع أيام الأسبوع</strong>
									<span>{restaurant.hours}</span>
								</div>
							</div>
						</section>
					</div>
					<div class="footer-copyright">
						<span>© {currentYear} {restaurantName}. جميع الحقوق محفوظة.</span>
					</div>
				</footer>
			)
		}

		<dialog id="menuDialog" class="menu-dialog" aria-label="Menu image viewer">
			<button class="close" type="button" aria-label="العودة">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M19 12H5m0 0 6-6m-6 6 6 6" />
				</svg>
				<span>رجوع</span>
			</button>
			<div class="image-stage">
				<div id="menuImages" class="menu-images" aria-live="polite"></div>
			</div>
		</dialog>

		<script type="application/json" id="categories-data" set:html={JSON.stringify(categories)} />

		<script>
			const dataElement = document.getElementById('categories-data');
			const categories = JSON.parse(dataElement?.textContent || '[]');
			const categoriesBySlug = new Map(categories.map((category) => [category.slug, category]));
			const dialog = document.getElementById('menuDialog');
			const menuImages = document.getElementById('menuImages');
			const imageStage = dialog?.querySelector('.image-stage');
			const closeButton = dialog?.querySelector('.close');
			let skipCloseUrlSync = false;
			let activeRenderRequest = 0;

			function resetMenuScroll(requestId) {
				if (requestId !== activeRenderRequest || !menuImages) return;
				const firstImage = menuImages.querySelector('img');
				menuImages.scrollTop = 0;
				imageStage?.scrollTo({ top: 0 });
				firstImage?.scrollIntoView({ block: 'nearest', inline: 'start' });
			}

			function setCategoryParam(slug) {
				const url = new URL(window.location.href);
				if (slug) {
					url.searchParams.set('category', slug);
				} else {
					url.searchParams.delete('category');
				}
				window.history.pushState({}, '', url);
			}

			function openCategory(category, shouldPushState = true) {
				if (!dialog || !menuImages || !category) return;

				const requestId = ++activeRenderRequest;
				dialog.dataset.imageState = 'loading';
				menuImages.replaceChildren();
				menuImages.classList.toggle('has-multiple-images', category.imageUrls.length > 1);
				resetMenuScroll(requestId);

				if (!dialog.open) {
					dialog.showModal();
				}

				category.imageUrls.forEach((imageUrl, index) => {
					const image = document.createElement('img');
					image.alt =
						category.imageUrls.length > 1
							? `${category.name} menu page ${index + 1}`
							: `${category.name} menu`;
					image.loading = index === 0 ? 'eager' : 'lazy';
					image.decoding = 'async';
					image.addEventListener(
						'load',
						() => {
							if (requestId === activeRenderRequest) {
								image.dataset.loaded = 'true';
								if (index === 0) resetMenuScroll(requestId);
							}
						},
						{ once: true }
					);
					image.src = imageUrl;
					menuImages.append(image);
					if (image.complete) {
						image.dataset.loaded = 'true';
					}
				});

				window.requestAnimationFrame(() => {
					resetMenuScroll(requestId);
					window.requestAnimationFrame(() => resetMenuScroll(requestId));
				});
				dialog.dataset.imageState = 'loaded';

				if (shouldPushState) {
					setCategoryParam(category.slug);
				}
			}

			function closeCategory(shouldPushState = true) {
				if (!dialog || !menuImages) return;
				activeRenderRequest++;
				dialog.dataset.imageState = 'loading';
				menuImages.replaceChildren();
				menuImages.classList.remove('has-multiple-images');
				if (dialog.open) {
					skipCloseUrlSync = true;
					dialog.close();
				}
				if (shouldPushState) {
					setCategoryParam('');
				}
			}

			document.querySelectorAll('.category-card').forEach((button) => {
				button.addEventListener('click', () => {
					const category = categoriesBySlug.get(button.dataset.slug);
					openCategory(category);
				});
			});

			closeButton?.addEventListener('click', () => closeCategory());
			dialog?.addEventListener('click', (event) => {
				if (
					!menuImages ||
					closeButton?.contains(event.target)
				)
					return;
				if (!menuImages.contains(event.target)) {
					closeCategory();
				}
			});
			dialog?.addEventListener('close', () => {
				if (skipCloseUrlSync) {
					skipCloseUrlSync = false;
					return;
				}

				const activeSlug = new URL(window.location.href).searchParams.get('category');
				if (activeSlug) {
					setCategoryParam('');
				}
			});

			window.addEventListener('popstate', () => {
				const slug = new URL(window.location.href).searchParams.get('category');
				const category = slug ? categoriesBySlug.get(slug) : null;
				if (category) {
					openCategory(category, false);
				} else {
					closeCategory(false);
				}
			});

			const initialSlug = new URL(window.location.href).searchParams.get('category');
			if (initialSlug && categoriesBySlug.has(initialSlug)) {
				openCategory(categoriesBySlug.get(initialSlug), false);
			}
		</script>
	</body>
</html>

<style>
	:root {
		color-scheme: light;
		--black: #0a0a0a;
		--gold: #c4a14b;
		--secondary: #b99645;
		--champagne: #d3bb7b;
		--dark-gold: #8a6a2a;
		--paper: #f2f2f2;
		--muted: #6b6250;
		--shadow: 0 18px 42px rgb(10 10 10 / 10%);
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		min-height: 100%;
		min-height: 100svh;
		background: #261f14;
		color: var(--paper);
	}

	body {
		min-height: 100vh;
		min-height: 100svh;
		min-height: 100dvh;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	button,
	a {
		-webkit-tap-highlight-color: transparent;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.1rem clamp(1.25rem, 5vw, 4.5rem);
		background: #fff;
		border-bottom: 1px solid var(--secondary);
	}

	.brand,
	.icon-link {
		color: var(--black);
		text-decoration: none;
	}

	.brand {
		display: flex;
		align-items: center;
		min-width: 0;
	}

	.brand-text {
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.4rem, 6vw, 4.25rem);
		font-weight: 700;
		line-height: 1;
	}

	.header-logo {
		display: block;
		width: clamp(8rem, 16vw, 12.5rem);
		max-width: 36vw;
		height: clamp(4rem, 9vw, 6rem);
		object-fit: contain;
	}

	.social-links {
		direction: ltr;
		display: flex;
		align-items: center;
		gap: 0.55rem;
	}

	.icon-link {
		width: 4.1rem;
		height: 4.1rem;
		border: 1px solid rgb(185 150 69 / 70%);
		border-radius: 999px;
		display: grid;
		place-items: center;
		background: transparent;
		transition:
			background 180ms ease,
			transform 180ms ease,
			border-color 180ms ease;
	}

	.icon-link:hover,
	.icon-link:focus-visible {
		background: var(--secondary);
		border-color: var(--secondary);
		color: var(--black);
		transform: translateY(-1px);
	}

	.icon-link svg {
		width: 2rem;
		height: 2rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.shell {
		width: min(1120px, calc(100% - 2rem));
		margin: 0 auto;
		padding: clamp(1.5rem, 5vw, 3rem) 0 4rem;
		flex: 1 0 auto;
		min-height: 0;
	}

	.category-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15.5rem), 1fr));
		gap: clamp(0.9rem, 2.5vw, 1.4rem);
	}

	.category-card {
		position: relative;
		min-height: clamp(8.5rem, 20vw, 12rem);
		overflow: hidden;
		border: 1px solid var(--secondary);
		border-radius: 8px;
		padding: clamp(1rem, 2.5vw, 1.4rem);
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: var(--paper);
		background: #261f14;
		box-shadow: var(--shadow);
		cursor: pointer;
		transform: translateY(0);
		transition:
			background 180ms ease,
			color 180ms ease,
			border-color 180ms ease,
			transform 180ms ease,
			box-shadow 180ms ease;
	}

	.category-card:hover,
	.category-card:focus-visible {
		background: var(--secondary);
		border-color: var(--secondary);
		color: var(--black);
		transform: translateY(-3px);
		box-shadow: 0 24px 52px rgb(10 10 10 / 14%);
	}

	.category-card:focus-visible,
	a:focus-visible {
		outline: 3px solid var(--dark-gold);
		outline-offset: 4px;
	}

	.category-name {
		position: relative;
		max-width: 100%;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(1.7rem, 5vw, 3rem);
		font-weight: 800;
		line-height: 1.35;
	}

	.empty-state {
		max-width: 34rem;
		padding: clamp(1.2rem, 4vw, 2rem);
		border: 1px solid rgb(185 150 69 / 45%);
		border-radius: 8px;
		background: rgb(185 150 69 / 8%);
	}

	.empty-state h2,
	.empty-state p {
		margin: 0;
	}

	.empty-state h2 {
		margin-bottom: 0.5rem;
		font-size: 1.2rem;
	}

	.empty-state p {
		direction: ltr;
		color: var(--muted);
	}

	.site-footer {
		--footer-pad-block: clamp(1.35rem, 3vw, 2rem);
		--footer-accent: #b97500;
		flex: 0 0 auto;
		margin-top: auto;
		padding: var(--footer-pad-block) clamp(1rem, 4vw, 3.5rem);
		padding-bottom: calc(var(--footer-pad-block) + env(safe-area-inset-bottom, 0px));
		border: 1px solid var(--secondary);
		border-inline: 0;
		border-bottom: 0;
		background: #fff;
		color: var(--black);
	}

	.footer-shell {
		display: grid;
		grid-template-columns: minmax(7rem, 0.45fr) minmax(18rem, 1fr) minmax(14rem, 0.82fr);
		align-items: start;
		gap: clamp(2.4rem, 7vw, 6rem);
		max-width: 1120px;
		margin-inline: auto;
	}

	.footer-brand {
		display: flex;
		align-items: flex-start;
		justify-content: flex-start;
		min-width: 0;
	}

	.footer-mark {
		font-family: Georgia, "Times New Roman", serif;
		color: var(--gold);
		font-size: 2rem;
		line-height: 1;
	}

	.footer-logo {
		width: clamp(8rem, 16vw, 12.5rem);
		max-width: 36vw;
		height: clamp(4rem, 9vw, 6rem);
		flex: 0 0 auto;
		display: block;
		object-fit: contain;
	}

	.footer-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		text-align: right;
	}

	.footer-title {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--black);
		font-size: clamp(1rem, 2.2vw, 1.18rem);
		font-weight: 900;
		line-height: 1;
	}

	.footer-title::before {
		content: "";
		width: 3px;
		height: 1.12em;
		flex: 0 0 auto;
		border-radius: 999px;
		background: var(--footer-accent);
	}

	.footer-contacts {
		min-width: 0;
	}

	.contact-list {
		display: grid;
